{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "test": "node scripts/test.mjs",
    "__dev": "yarn typegen && next dev --webpack",
    "__build": "next build --webpack",
    "__test": "jest",
    "postinstall": "is-ci || husky || true",
    "build_and_analyze": "ANALYZE=true npx -y yarn build",
    "build_and_run_in_docker": "bash scripts/build_and_run_in_docker.sh",
    "typegen": "next typegen",
    "optimize_svg_icons": "svgo",
    "optimize_svg_icons:all": "npx -y yarn optimize_svg_icons -rf src/assets/icons",
    "test:CI": "npx -y yarn test --passWithNoTests",
    "lint:prettier": "prettier --ignore-unknown",
    "lint:prettier:CI": "npx -y yarn prettier --check .",
    "lint:prettier:fix": "npx -y yarn lint:prettier:CI --write",
    "lint:stylelint:CI": "stylelint \"**/*.{css,scss}\"",
    "lint:stylelint:fix": "npx -y yarn lint:stylelint:CI --fix",
    "lint:eslint": "eslint --max-warnings 0 --report-unused-disable-directives",
    "lint:eslint:CI": "npx -y yarn typegen && eslint \"**/*.{js,jsx,ts,tsx,cjs,mjs}\"",
    "lint:eslint:fix": "npx -y yarn lint:eslint:CI --fix",
    "typescript:CI": "npx -y yarn typegen && tsc --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/konkhmer-sleokchher": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@mui/material": "7.3.9",
    "@mui/material-nextjs": "7.3.9",
    "@next/bundle-analyzer": "16.2.6",
    "@sindresorhus/is": "8.0.0",
    "@svgr/webpack": "8.1.0",
    "@testing-library/dom": "10.4.1",
    "@types/lodash": "4.17.24",
    "@types/matter-js": "0.20.2",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "bootstrap": "5.3.8",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "execa": "9.6.1",
    "is-ci": "4.1.0",
    "lodash": "4.18.1",
    "matter-js": "0.20.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-error-boundary": "6.1.1",
    "react-intersection-observer": "10.0.3",
    "sanitize.css": "13.0.0",
    "sass": "1.99.0",
    "swiper": "12.1.3",
    "type-fest": "5.6.0",
    "type-testing": "0.2.0",
    "typescript": "5.9.3",
    "web-vitals": "5.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "eslint": "9",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-handle-errors": "0.3.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.1",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "stylelint": "17.6.0",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "svgo": "4.0.1"
  }
}
